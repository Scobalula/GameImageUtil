#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D albedoTex;
layout(set = 0, binding = 1) uniform sampler2D specTex;
layout(set = 0, binding = 2) uniform writeonly image2D fusedOutputImage;
layout(set = 0, binding = 3) uniform writeonly image2D metalnessOutputImage;

layout(push_constant) uniform Params {
    int outWidth;
    int outHeight;
    int albedoWidth;
    int albedoHeight;
    int specWidth;
    int specHeight;
    float insulatorSpecRange;
    float fp16MinValue;
    int packMetalnessInAlpha;
};

float saturateFloat(float value) {
    return clamp(value, 0.0, 1.0);
}

vec3 saturateVec3(vec3 value) {
    return clamp(value, vec3(0.0), vec3(1.0));
}

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    if (pos.x >= outWidth || pos.y >= outHeight)
        return;

    vec2 uv = (vec2(pos) + 0.5) / vec2(outWidth, outHeight);
    vec4 albedoSample = texelFetch(albedoTex, pos, 0);
    vec4 specularSample = texture(specTex, uv);
    vec3 albedo = albedoSample.rgb;
    vec3 specular = specularSample.rgb;

    float nonmetal = (albedo.r + albedo.g + albedo.b) * (1.0 / 3.0);
    float metal = (specular.r + specular.g + specular.b) * (1.0 / 3.0);

    nonmetal = saturateFloat(nonmetal + fp16MinValue);
    float specE = saturateFloat(metal - insulatorSpecRange);
    float specI = min(metal, insulatorSpecRange);

    float metalness = specE / (specE + nonmetal);
    metalness = specI + (1.0 - insulatorSpecRange) * metalness;
    vec3 fusedAlbedoSpec = (saturateVec3(specular - insulatorSpecRange)) + albedo;

    imageStore(fusedOutputImage, pos, vec4(fusedAlbedoSpec.rgb, 1.0));

    vec4 metalnessOutput = packMetalnessInAlpha != 0 ? vec4(albedo, metalness) : vec4(metalness, metalness, metalness, 1.0);
    imageStore(metalnessOutputImage, pos, metalnessOutput);
}
