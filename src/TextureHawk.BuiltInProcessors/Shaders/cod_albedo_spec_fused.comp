#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D albedoTex;
layout(set = 0, binding = 1) uniform sampler2D specTex;
layout(set = 0, binding = 2) uniform writeonly image2D outputImage;

layout(push_constant) uniform Params {
    int outWidth;
    int outHeight;
    int albedoWidth;
    int albedoHeight;
    int specWidth;
    int specHeight;
    float insulatorSpecRange;
    float fp16MinValue;
    int packMetalnessInAlpha;
};

vec3 saturateVec3(vec3 value) {
    return clamp(value, vec3(0.0), vec3(1.0));
}

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    if (pos.x >= outWidth || pos.y >= outHeight)
        return;

    vec2 uv = (vec2(pos) + 0.5) / vec2(outWidth, outHeight);
    vec3 albedo = texelFetch(albedoTex, pos, 0).rgb;
    vec3 specular = texture(specTex, uv).rgb;

    vec3 fusedAlbedoSpec = saturateVec3(saturateVec3(specular - vec3(insulatorSpecRange)) + albedo);

    imageStore(outputImage, pos, vec4(fusedAlbedoSpec, 1.0));
}
