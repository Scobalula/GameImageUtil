#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform samplerCube cubemapTex;
layout(set = 0, binding = 1) uniform writeonly image2D outputImage;

layout(push_constant) uniform Params {
    int outWidth;
    int outHeight;
    int mapX;
    int mapY;
    int mapZ;
};

float resolveAxis(vec3 dir, int axis) {
    if (axis == 0) return dir.x;
    if (axis == 1) return -dir.x;
    if (axis == 2) return dir.y;
    if (axis == 3) return -dir.y;
    if (axis == 4) return dir.z;
    return -dir.z;
}

// Decode packed hemi-octahedral UV to a 3D direction.
// Left half (u < 0.5) = upper hemisphere, right half = lower hemisphere.
vec3 decodeHemiOcta(vec2 packedUv) {
    bool upper = packedUv.x < 0.5;
    vec2 localUv = packedUv;
    localUv.x = upper ? localUv.x * 2.0 : (localUv.x - 0.5) * 2.0;
    vec2 oct = localUv * 2.0 - 1.0;

    float x = 0.5 * (oct.x + oct.y);
    float z = 0.5 * (oct.y - oct.x);
    float y = 1.0 - abs(x) - abs(z);
    if (!upper)
        y = -y;

    return normalize(vec3(x, y, z));
}

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    if (pos.x >= outWidth || pos.y >= outHeight)
        return;

    vec2 packedUv = (vec2(pos) + 0.5) / vec2(outWidth, outHeight);
    vec3 hemiDir = decodeHemiOcta(packedUv);

    vec3 remapped = vec3(-hemiDir.x, -hemiDir.y, hemiDir.z);
    vec3 sampleDir = normalize(vec3(
        resolveAxis(remapped, mapX),
        resolveAxis(remapped, mapY),
        resolveAxis(remapped, mapZ)));

    vec4 pixel = textureLod(cubemapTex, sampleDir, 0.0);
    imageStore(outputImage, pos, pixel);
}
