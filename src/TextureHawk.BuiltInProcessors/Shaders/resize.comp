#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D inputTex;
layout(set = 0, binding = 1) uniform writeonly image2D outputImage;

layout(push_constant) uniform Params {
    int outWidth;
    int outHeight;
    int srcWidth;
    int srcHeight;
};

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    if (pos.x >= outWidth || pos.y >= outHeight) return;

    vec2 uv = (vec2(pos) + 0.5) / vec2(outWidth, outHeight);
    vec4 pixel = texture(inputTex, uv);
    imageStore(outputImage, pos, pixel);
}
