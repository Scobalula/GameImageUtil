#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D inputTex;
layout(set = 0, binding = 1) uniform writeonly image2D outputImage;

layout(push_constant) uniform Params {
    int outWidth;
    int outHeight;
    int invertAlpha;
};

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    if (pos.x >= outWidth || pos.y >= outHeight) return;

    vec4 pixel = texelFetch(inputTex, pos, 0);
    vec3 inverted = vec3(1.0) - pixel.rgb;
    float alpha = invertAlpha != 0 ? 1.0 - pixel.a : pixel.a;

    imageStore(outputImage, pos, vec4(inverted, alpha));
}
