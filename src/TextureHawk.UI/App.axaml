<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TextureHawk.UI.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://TextureHawk.UI/Themes/Theme.axaml" />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <!-- Force square Fluent geometry globally -->
            <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>

            <!-- Accent — injected at runtime, defaults to magenta -->
            <SolidColorBrush x:Key="AccentBrush" Color="#E91E63" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#F06292" />
            <SolidColorBrush x:Key="AccentPressedBrush" Color="#C2185B" />
            <SolidColorBrush x:Key="AccentGlowBrush" Color="#33E91E63" />

            <LinearGradientBrush x:Key="AccentGradient" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#E91E63" Offset="0" />
                <GradientStop Color="#C2185B" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="AccentHoverGradient" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#F06292" Offset="0" />
                <GradientStop Color="#E91E63" Offset="1" />
            </LinearGradientBrush>

            <!-- Semantic colors -->
            <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#EF5350" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FFA726" />

            <ResourceDictionary.ThemeDictionaries>
                <!-- ═══════ DARK THEME ═══════ -->
                <ResourceDictionary x:Key="Dark">
                    <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
                    <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>

                    <!-- Window -->
                    <SolidColorBrush x:Key="WindowBg" Color="#161618" />
                    <SolidColorBrush x:Key="WindowFg" Color="#A4A4AA" />

                    <!-- Card -->
                    <SolidColorBrush x:Key="CardBg" Color="#242427" />
                    <SolidColorBrush x:Key="CardBorder" Color="#333338" />
                    <SolidColorBrush x:Key="CardSubtleBg" Color="#212124" />
                    <SolidColorBrush x:Key="CardSubtleBorder" Color="#2C2C30" />

                    <!-- Sidebar -->
                    <SolidColorBrush x:Key="SidebarBg" Color="#1E1E21" />
                    <SolidColorBrush x:Key="SidebarBorder" Color="#2A2A2E" />

                    <!-- StatusBar -->
                    <SolidColorBrush x:Key="StatusBarBg" Color="#171719" />
                    <SolidColorBrush x:Key="StatusBarBorder" Color="#2A2A2E" />

                    <!-- TextureItem -->
                    <SolidColorBrush x:Key="TextureItemBg" Color="#212124" />
                    <SolidColorBrush x:Key="TextureItemBorder" Color="#2C2C30" />
                    <SolidColorBrush x:Key="TextureItemHoverBg" Color="#2A2A2D" />
                    <SolidColorBrush x:Key="TextureItemHoverBorder" Color="#404044" />
                    <SolidColorBrush x:Key="TextureItemSelectedBg" Color="#1A2A2E" />
                    <SolidColorBrush x:Key="TextureItemSelectedBorder" Color="#2A3A3E" />

                    <!-- Text -->
                    <SolidColorBrush x:Key="TextPrimary" Color="#E4E4EA" />
                    <SolidColorBrush x:Key="TextSecondary" Color="#D0D0D6" />
                    <SolidColorBrush x:Key="TextDim" Color="#78787E" />
                    <SolidColorBrush x:Key="TextMuted" Color="#6E6E74" />
                    <SolidColorBrush x:Key="TextDisabled" Color="#606066" />

                    <!-- Buttons -->
                    <SolidColorBrush x:Key="SubtleBtnBg" Color="#2A2A2E" />
                    <SolidColorBrush x:Key="SubtleBtnBorder" Color="#333338" />
                    <SolidColorBrush x:Key="SubtleBtnFg" Color="#C4C4CA" />
                    <SolidColorBrush x:Key="SubtleBtnHoverBg" Color="#343437" />
                    <SolidColorBrush x:Key="SubtleBtnHoverBorder" Color="#404044" />
                    <SolidColorBrush x:Key="SubtleBtnHoverFg" Color="#E4E4EA" />
                    <SolidColorBrush x:Key="SubtleBtnPressedBg" Color="#3C3C40" />
                    <SolidColorBrush x:Key="CancelBtnBg" Color="#323236" />
                    <SolidColorBrush x:Key="CancelBtnBorder" Color="#3A3A3E" />
                    <SolidColorBrush x:Key="CancelBtnFg" Color="#B4B4BA" />
                    <SolidColorBrush x:Key="CancelBtnHoverBg" Color="#424246" />
                    <SolidColorBrush x:Key="CancelBtnHoverBorder" Color="#4A4A4E" />
                    <SolidColorBrush x:Key="ToolbarBtnFg" Color="#A0A0A6" />
                    <SolidColorBrush x:Key="ToolbarBtnHoverBg" Color="#2A2D30" />
                    <SolidColorBrush x:Key="ToolbarBtnHoverFg" Color="#E4E4EA" />
                    <SolidColorBrush x:Key="ToolbarBtnPressedBg" Color="#333338" />

                    <!-- TextBox/ComboBox -->
                    <SolidColorBrush x:Key="TextBoxBg" Color="#1D1D20" />
                    <SolidColorBrush x:Key="TextBoxBorder" Color="#333338" />

                    <!-- Misc -->
                    <SolidColorBrush x:Key="DropzoneBorder" Color="#333338" />
                    <SolidColorBrush x:Key="ProgressBarBg" Color="#1E1E22" />
                    <SolidColorBrush x:Key="ProgressOverlayBg" Color="#DD0C0C0F" />
                    <SolidColorBrush x:Key="ProgressCardBg" Color="#282830" />
                    <SolidColorBrush x:Key="ProgressCardBorder" Color="#3A3A3E" />
                    <SolidColorBrush x:Key="SeparatorBg" Color="#2A2A2E" />
                    <SolidColorBrush x:Key="ScrollThumb" Color="#3A3A3E" />
                    <SolidColorBrush x:Key="ScrollThumbHover" Color="#505054" />
                    <SolidColorBrush x:Key="ScrollThumbPressed" Color="#606064" />

                    <!-- Fluent control overrides -->
                    <SolidColorBrush x:Key="ComboBoxBackground" Color="#1E1E22" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#242428" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#2A2A2E" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#161619" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#333338" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#404044" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#E91E63" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="#2A2A2E" />
                    <SolidColorBrush x:Key="ComboBoxForeground" Color="#E0E0E6" />
                    <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="#E4E4EA" />
                    <SolidColorBrush x:Key="ComboBoxForegroundPressed" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="#606066" />
                    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#A0A0A6" />
                    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#252528" />
                    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#333338" />
                    <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#E0E0E6" />
                    <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#2A2A2E" />
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="#333338" />
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#2B0D1E" />
                    <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#FFFFFF" />

                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="#1E1E22" />
                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="#242428" />
                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPressed" Color="#2A2A2E" />
                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#E91E63" />
                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#F06292" />
                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#C2185B" />
                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="#444448" />
                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="#555558" />
                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#E91E63" />
                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#F06292" />
                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundUnchecked" Color="Transparent" />
                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CheckBoxForeground" Color="#E0E0E6" />
                    <SolidColorBrush x:Key="CheckBoxForegroundPointerOver" Color="#E4E4EA" />
                    <SolidColorBrush x:Key="CheckBoxForegroundPressed" Color="#E4E4EA" />
                    <SolidColorBrush x:Key="CheckBoxForegroundChecked" Color="#E0E0E6" />
                    <SolidColorBrush x:Key="CheckBoxForegroundCheckedPointerOver" Color="#E4E4EA" />
                    <SolidColorBrush x:Key="CheckBoxForegroundCheckedPressed" Color="#E4E4EA" />
                    <SolidColorBrush x:Key="CheckBoxForegroundDisabled" Color="#606066" />
                    <SolidColorBrush x:Key="CheckBoxForegroundCheckedDisabled" Color="#606066" />

                    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#252528" />
                    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#333338" />
                    <SolidColorBrush x:Key="MenuFlyoutItemBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#2A2D30" />
                    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#333338" />
                    <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="#CCCCCC" />
                    <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="MenuFlyoutItemForegroundDisabled" Color="#606066" />

                    <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#3A3A3E" />
                    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#505054" />
                    <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#606064" />
                    <SolidColorBrush x:Key="ScrollBarTrackFill" Color="Transparent" />
                    <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="#18181B" />

                    <SolidColorBrush x:Key="TextControlBackground" Color="#1E1E22" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#222226" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1E1E22" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#333338" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#404044" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#E91E63" />
                    <SolidColorBrush x:Key="TextControlForeground" Color="#E0E0E6" />
                    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#E4E4EA" />
                    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#606066" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#606066" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#707076" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#707076" />
                    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#40E91E63" />

                    <SolidColorBrush x:Key="ListBoxItemBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ListBoxItemBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ListBoxItemBackgroundPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ListBoxItemBackgroundSelected" Color="Transparent" />
                    <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ListBoxItemForeground" Color="#E4E4EA" />
                    <SolidColorBrush x:Key="ListBoxItemForegroundPointerOver" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ListBoxItemForegroundPressed" Color="#E4E4EA" />
                    <SolidColorBrush x:Key="ListBoxItemForegroundSelected" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ListBoxItemForegroundSelectedPointerOver" Color="#FFFFFF" />

                    <SolidColorBrush x:Key="ButtonForeground" Color="#E0E0E6" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#E0E0E6" />
                    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#606066" />
                </ResourceDictionary>

                <!-- ═══════ LIGHT THEME ═══════ -->
                <ResourceDictionary x:Key="Light">
                    <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
                    <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>

                    <!-- Window -->
                    <SolidColorBrush x:Key="WindowBg" Color="#F3F3F6" />
                    <SolidColorBrush x:Key="WindowFg" Color="#1A1A1E" />

                    <!-- Card -->
                    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CardBorder" Color="#D4D4D8" />
                    <SolidColorBrush x:Key="CardSubtleBg" Color="#F7F7FA" />
                    <SolidColorBrush x:Key="CardSubtleBorder" Color="#E0E0E4" />

                    <!-- Sidebar -->
                    <SolidColorBrush x:Key="SidebarBg" Color="#EBEBEF" />
                    <SolidColorBrush x:Key="SidebarBorder" Color="#D4D4D8" />

                    <!-- StatusBar -->
                    <SolidColorBrush x:Key="StatusBarBg" Color="#E4E4E8" />
                    <SolidColorBrush x:Key="StatusBarBorder" Color="#D4D4D8" />

                    <!-- TextureItem -->
                    <SolidColorBrush x:Key="TextureItemBg" Color="#F7F7FA" />
                    <SolidColorBrush x:Key="TextureItemBorder" Color="#E0E0E4" />
                    <SolidColorBrush x:Key="TextureItemHoverBg" Color="#ECECF0" />
                    <SolidColorBrush x:Key="TextureItemHoverBorder" Color="#C0C0C6" />
                    <SolidColorBrush x:Key="TextureItemSelectedBg" Color="#E0F0F2" />
                    <SolidColorBrush x:Key="TextureItemSelectedBorder" Color="#B0D8DE" />

                    <!-- Text -->
                    <SolidColorBrush x:Key="TextPrimary" Color="#1A1A1E" />
                    <SolidColorBrush x:Key="TextSecondary" Color="#3A3A40" />
                    <SolidColorBrush x:Key="TextDim" Color="#78787E" />
                    <SolidColorBrush x:Key="TextMuted" Color="#888890" />
                    <SolidColorBrush x:Key="TextDisabled" Color="#A0A0A6" />

                    <!-- Buttons -->
                    <SolidColorBrush x:Key="SubtleBtnBg" Color="#E8E8EC" />
                    <SolidColorBrush x:Key="SubtleBtnBorder" Color="#D4D4D8" />
                    <SolidColorBrush x:Key="SubtleBtnFg" Color="#44444A" />
                    <SolidColorBrush x:Key="SubtleBtnHoverBg" Color="#DCDCE0" />
                    <SolidColorBrush x:Key="SubtleBtnHoverBorder" Color="#C0C0C6" />
                    <SolidColorBrush x:Key="SubtleBtnHoverFg" Color="#1A1A1E" />
                    <SolidColorBrush x:Key="SubtleBtnPressedBg" Color="#D0D0D4" />
                    <SolidColorBrush x:Key="CancelBtnBg" Color="#E0E0E4" />
                    <SolidColorBrush x:Key="CancelBtnBorder" Color="#D0D0D4" />
                    <SolidColorBrush x:Key="CancelBtnFg" Color="#44444A" />
                    <SolidColorBrush x:Key="CancelBtnHoverBg" Color="#D4D4D8" />
                    <SolidColorBrush x:Key="CancelBtnHoverBorder" Color="#C0C0C6" />
                    <SolidColorBrush x:Key="ToolbarBtnFg" Color="#606068" />
                    <SolidColorBrush x:Key="ToolbarBtnHoverBg" Color="#DCDCE0" />
                    <SolidColorBrush x:Key="ToolbarBtnHoverFg" Color="#1A1A1E" />
                    <SolidColorBrush x:Key="ToolbarBtnPressedBg" Color="#D0D0D4" />

                    <!-- TextBox/ComboBox -->
                    <SolidColorBrush x:Key="TextBoxBg" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextBoxBorder" Color="#D4D4D8" />

                    <!-- Misc -->
                    <SolidColorBrush x:Key="DropzoneBorder" Color="#D4D4D8" />
                    <SolidColorBrush x:Key="ProgressBarBg" Color="#E0E0E4" />
                    <SolidColorBrush x:Key="ProgressOverlayBg" Color="#BBFAFAFA" />
                    <SolidColorBrush x:Key="ProgressCardBg" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ProgressCardBorder" Color="#D4D4D8" />
                    <SolidColorBrush x:Key="SeparatorBg" Color="#D4D4D8" />
                    <SolidColorBrush x:Key="ScrollThumb" Color="#C0C0C4" />
                    <SolidColorBrush x:Key="ScrollThumbHover" Color="#A0A0A4" />
                    <SolidColorBrush x:Key="ScrollThumbPressed" Color="#888890" />

                    <!-- Fluent control overrides -->
                    <SolidColorBrush x:Key="ComboBoxBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#F5F5F8" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#EBEBEF" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#F0F0F3" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#D4D4D8" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#C0C0C6" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#E91E63" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="#E0E0E4" />
                    <SolidColorBrush x:Key="ComboBoxForeground" Color="#1A1A1E" />
                    <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="#1A1A1E" />
                    <SolidColorBrush x:Key="ComboBoxForegroundPressed" Color="#1A1A1E" />
                    <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="#A0A0A6" />
                    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#606068" />
                    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#D4D4D8" />
                    <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#1A1A1E" />
                    <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="#1A1A1E" />
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#EBEBEF" />
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="#DCDCE0" />
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#F4D4E0" />
                    <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#1A1A1E" />

                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="#F5F5F8" />
                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPressed" Color="#EBEBEF" />
