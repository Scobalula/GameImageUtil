                    <SolidColorBrush x:Key="ButtonForeground" Color="#1A1A1E" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#1A1A1E" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#1A1A1E" />
                    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#A0A0A6" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- SVG icon geometries (multi-color via DrawingImage where appropriate) -->
            <StreamGeometry x:Key="IconPlay">M8,5V19L19,12Z</StreamGeometry>
            <StreamGeometry x:Key="IconPlus">M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z</StreamGeometry>
            <StreamGeometry x:Key="IconTrash">M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z</StreamGeometry>
            <StreamGeometry x:Key="IconClose">M19,6.41L17.59,5 12,10.59 6.41,5 5,6.41 10.59,12 5,17.59 6.41,19 12,13.41 17.59,19 19,17.59 13.41,12Z</StreamGeometry>
