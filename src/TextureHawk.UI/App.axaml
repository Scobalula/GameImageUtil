                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="#C0C0C6" />
                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="#A0A0A6" />
                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#E91E63" />
                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#F06292" />
                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundUnchecked" Color="Transparent" />
                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FFFFFF" />
