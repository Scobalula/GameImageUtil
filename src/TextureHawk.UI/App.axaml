                    <SolidColorBrush x:Key="CheckBoxForeground" Color="#1A1A1E" />
                    <SolidColorBrush x:Key="CheckBoxForegroundPointerOver" Color="#1A1A1E" />
                    <SolidColorBrush x:Key="CheckBoxForegroundPressed" Color="#1A1A1E" />
                    <SolidColorBrush x:Key="CheckBoxForegroundChecked" Color="#1A1A1E" />
                    <SolidColorBrush x:Key="CheckBoxForegroundCheckedPointerOver" Color="#1A1A1E" />
                    <SolidColorBrush x:Key="CheckBoxForegroundCheckedPressed" Color="#1A1A1E" />
                    <SolidColorBrush x:Key="CheckBoxForegroundDisabled" Color="#A0A0A6" />
                    <SolidColorBrush x:Key="CheckBoxForegroundCheckedDisabled" Color="#A0A0A6" />

                    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#D4D4D8" />
                    <SolidColorBrush x:Key="MenuFlyoutItemBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#EBEBEF" />
                    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#DCDCE0" />
                    <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="#3A3A40" />
                    <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="#1A1A1E" />
                    <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="#1A1A1E" />
                    <SolidColorBrush x:Key="MenuFlyoutItemForegroundDisabled" Color="#A0A0A6" />

                    <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#C0C0C4" />
                    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#A0A0A4" />
                    <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#888890" />
                    <SolidColorBrush x:Key="ScrollBarTrackFill" Color="Transparent" />
                    <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="#EBEBEF" />

                    <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#F5F5F8" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#D4D4D8" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#C0C0C6" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#E91E63" />
                    <SolidColorBrush x:Key="TextControlForeground" Color="#1A1A1E" />
                    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#1A1A1E" />
                    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#1A1A1E" />
                    <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#A0A0A6" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#A0A0A6" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#888890" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#888890" />
                    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#40E91E63" />

                    <SolidColorBrush x:Key="ListBoxItemBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ListBoxItemBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ListBoxItemBackgroundPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ListBoxItemBackgroundSelected" Color="Transparent" />
