#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D srcTex;
layout(binding = 1, rgba8) uniform writeonly image2D dstImage;

layout(push_constant) uniform Params {
    int outWidth;
    int outHeight;
    int srcWidth;
    int srcHeight;
    float redBoost;
} pc;

void main()
{
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    if (pos.x >= pc.outWidth || pos.y >= pc.outHeight)
        return;

    vec2 uv = (vec2(pos) + 0.5) / vec2(pc.outWidth, pc.outHeight);
    vec4 color = texture(srcTex, uv);
    color.r = clamp(color.r * pc.redBoost, 0.0, 1.0);
    imageStore(dstImage, pos, color);
}